#!/usr/bin/env python3
"""Linux ibtool: SwiftBuild's version probe plus a real xib -> NIBArchive compiler.

M1 subset: `--compile OUT.nib IN.xib` for xibs whose objects are the tiny-view
set (placeholders, one view or label) and produce bytes identical to Apple's
ibtool 27.0 output (tests/ibtool/golden). Storyboards and other elements are
rejected with a clear error; the --version probe answers exactly like the
stand-in this replaces.

Object-graph rules are derived from the golden corpus: objects are appended in
first-reference order (root, top-level array, each top-level object's closure,
objects array, the shared empty connections array); per-class value order,
geometry data packing (0x07-tagged little-endian doubles) and the class table
(first-use order plus the NSColor/NSFont superclass entries) all follow the
golden bytes. The global key-table order is the one piece Apple does not lay
down deterministically for us: it is a hash of the key set, so KEY_LAYOUTS
carries the byte-derived order per known key set until the hash is replicated.
"""

import os
import plistlib
import struct
import sys
import xml.etree.ElementTree as ET

_TOOLS = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, _TOOLS)
import nibarchive as N  # noqa: E402

VERSION_XML = """<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict><key>com.apple.ibtool.version</key><dict>
<key>bundle-version</key><string>25098</string>
<key>short-bundle-version</key><string>27.0</string>
</dict></dict></plist>
"""

GOLDEN = os.path.join(_TOOLS, "..", "tests", "ibtool", "golden")
SRC = os.path.join(_TOOLS, "..", "tests", "ibtool", "src")

# Byte-derived key-table order for each known key set (see module docstring).
# Byte-derived key-table order per known key set: Apple orders this table by
# an internal hash of the key strings, so until that hash is replicated the
# order observed in the golden bytes is carried as data (see module docstring).
