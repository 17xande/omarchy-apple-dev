class XibError(Exception):
    pass


class Obj:
    def __init__(self, builder, cls):
        self.idx = len(builder.objects)
        builder.objects.append(self)
        self.cls = cls
        self.values = []  # (key str, N.Value payload tuple: (type, payload))

    def add(self, key, vtype, payload):
        self.values.append((key, N.Value(0, vtype, payload)))  # key_idx patched later


class Builder:
    def __init__(self):
        self.objects = []
        self.strings = {}  # text -> Obj
        self.colors = {}   # (name, resource tuple) -> Obj
        self.fonts = {}    # font key -> Obj

    def new(self, cls):
        return Obj(self, cls)

    def string(self, text):
        obj = self.strings.get(text)
        if obj is None:
            obj = self.new("NSString")
            obj.add("NS.bytes", N.DATA, text.encode("utf-8"))
            self.strings[text] = obj
        return obj

    def ref(self, obj):
        return (N.OBJREF, obj.idx)

    @staticmethod
    def boolean(v):
        return (N.TRUE if v else N.FALSE, None)

    @staticmethod
    def int8(v):
        return (N.INT8, v)

    @staticmethod
    def int64(v):
        return (N.INT64, v)

    @staticmethod
    def float32(v):
        return (N.FLOAT, struct.unpack("<f", struct.pack("<f", v))[0])

    @staticmethod
    def float64(v):
        return (N.DOUBLE, v)

    @staticmethod
    def geom(*nums):
        return (N.DATA, b"\x07" + struct.pack(f"<{len(nums)}d", *nums))


def _attr(el, name, where):
    v = el.get(name)
    if v is None:
        raise XibError(f"<{el.tag}> is missing attribute {name!r} ({where})")
    return v


def _sub(el, key, where):
    child = el.find(f"*[@key='{key}']")
    if child is None:
        raise XibError(f"<{el.tag}> is missing <key='{key}'> subelement ({where})")
    return child


def _bounds_center(el):
    x, y, w, h = _frame(el)
    return (0.0, 0.0, w, h), (x + w / 2, y + h / 2)


def _frame(el):
    rect = _sub(el, "frame", el.tag)
    try:
        return (float(rect.get("x", "0.0")), float(rect.get("y", "0.0")),
                float(rect.get("width")), float(rect.get("height")))
    except (TypeError, ValueError):
        raise XibError(f"<{el.tag}> has an unparsable frame rect")


def build_color(b, name, where, resources=None):
    key = (name, resources.get(name) if resources else None)
    if key in b.colors:
        return b.colors[key]
    obj = _build_color_new(b, name, where, resources)
    b.colors[key] = obj
    return obj


def _build_color_new(b, name, where, resources):
    if name in SYSTEM_COLORS:
        white, digits = SYSTEM_COLORS[name]
        c = b.new("UIColor")
        c.add("UISystemColorName", *b.ref(b.string(name)))
        c.add("UIColorComponentCount", *b.int8(2))
        c.add("UIWhite", *b.float32(white))
        c.add("UIAlpha", *b.float32(1.0))
        c.add("NSWhite", N.DATA, digits.encode("ascii"))
        c.add("NSColorSpace", *b.int8(4))
        return c
    if resources and name in resources:
        r, g, bl, al = resources[name]
        # Apple rounds component doubles to 10 significant digits and renders
        # NSRGB from those rounded values with %.3g.
        rr, gr, br, ar = (float(f"{v:.10g}") for v in (r, g, bl, al))
        c = b.new("UIColor")
        c.add("UISystemColorName", *b.ref(b.string(name)))
        c.add("UIColorComponentCount", *b.int8(4))
        for k, v in (("UIRed", rr), ("UIGreen", gr), ("UIBlue", br), ("UIAlpha", ar)):
            c.add(k, *b.float32(v))
            c.add(k + "-Double", *b.float64(v))
        c.add("NSRGB", N.DATA, " ".join(f"{v:.3g}" for v in (rr, gr, br, ar)).encode("ascii"))
        c.add("NSColorSpace", *b.int8(2))
        return c
    raise XibError(f"unsupported color {name!r} ({where})")


def build_font(b, fd, where):
    if fd.get("style") is not None:
        key = ("style", fd.get("style"))
        if key in b.fonts:
            return b.fonts[key]
        obj = _build_font_new(b, fd, where)
        b.fonts[key] = obj
        return obj
    key = ("system", fd.get("pointSize"))
    if key in b.fonts:
        return b.fonts[key]
    obj = _build_font_new(b, fd, where)
    b.fonts[key] = obj
    return obj


def _build_font_new(b, fd, where):
    if fd.get("style") is not None:
        style = fd.get("style")
        if style not in FONT_STYLE_SIZES:
            raise XibError(f"unsupported fontDescription style {style!r} ({where})")
        size = FONT_STYLE_SIZES[style]
        name = ".SFUI-Regular"
        f = b.new("UIFont")
        f.add("UIFontName", *b.ref(b.string(name)))
        f.add("UIIBTextStyle", *b.ref(b.string(style)))
        f.add("UIFontPointSize", *b.float64(0.0))
        f.add("UIFontTextStyleForScaling", N.NIL, None)
        f.add("UIFontPointSizeForScaling", *b.float64(0.0))
        f.add("UIFontMaximumPointSizeAfterScaling", *b.float64(0.0))
        f.add("UIFontTraits", *b.int8(0))
        f.add("UISystemFont", *b.boolean(False))
        f.add("NSName", *b.ref(b.string(name)))  # pool hit
        f.add("NSSize", *b.float64(size))
        return f
    if fd.get("type") != "system" or fd.get("pointSize") is None:
        raise XibError(f"unsupported fontDescription {fd.attrib} ({where})")
    size = float(fd.get("pointSize"))
    name = ".SFUI-Regular"
    f = b.new("UIFont")
    f.add("UIFontName", *b.ref(b.string(name)))
    desc = b.new("UIFontDescriptor")  # shell first: golden creates it before the dict
    entries = [("NSCTFontUIUsageAttribute", "CTFontRegularUsage"),
               ("NSFontSizeAttribute", None)]
    attrs = b.new("NSDictionary")
    attrs.add("NSInlinedValue", *b.boolean(False))
    for k, v in entries:
        attrs.add("UINibEncoderEmptyKey", *b.ref(b.string(k)))
        if v is None:
            num = b.new("NSNumber")
            num.add("NS.dblval", *b.float64(size))
            attrs.add("UINibEncoderEmptyKey", *b.ref(num))
        else:
            attrs.add("UINibEncoderEmptyKey", *b.ref(b.string(v)))
    desc.add("UIFontDescriptorAttributes", *b.ref(attrs))
    desc.add("UIFontDescriptorOptions", *b.int64(2147517444))
    f.add("UIFontDescriptor", *b.ref(desc))
    f.add("UIFontPointSize", *b.float64(size))
    f.add("UIFontTextStyleForScaling", N.NIL, None)
    f.add("UIFontPointSizeForScaling", *b.float64(0.0))
    f.add("UIFontMaximumPointSizeAfterScaling", *b.float64(0.0))
    f.add("UIFontTraits", *b.int8(0))
    f.add("UISystemFont", *b.boolean(False))
    f.add("NSName", *b.ref(b.string(name)))  # pool hit
    f.add("NSSize", *b.float64(size))
    return f


ALLOWED_ATTRS = {
    "view": {"key", "contentMode", "id", "opaque", "clipsSubviews",
             "multipleTouchEnabled", "autoresizesSubviews",
             "translatesAutoresizingMaskIntoConstraints"},
    "label": {"contentMode", "id", "opaque", "userInteractionEnabled", "text",
              "textAlignment", "horizontalHuggingPriority",
              "verticalHuggingPriority", "translatesAutoresizingMaskIntoConstraints",
              "lineBreakMode", "baselineAdjustment", "adjustsFontSizeToFit",
              "adjustsFontForContentSizeCategory"},
    "placeholder": {"placeholderIdentifier", "id", "userLabel", "customClass"},
    "tableViewCell": {"clipsSubviews", "contentMode",
                      "preservesSuperviewLayoutMargins", "selectionStyle",
                      "accessoryType", "indentationWidth", "reuseIdentifier",
                      "textLabel", "detailTextLabel", "style", "id",
                      "customClass", "customModule", "customModuleProvider"},
    "tableViewCellContentView": {"key", "opaque", "clipsSubviews",
                                 "multipleTouchEnabled", "contentMode",
                                 "preservesSuperviewLayoutMargins",
                                 "insetsLayoutMarginsFromSafeArea",
                                 "tableViewCell", "id"},
    "cell-label": {"opaque", "multipleTouchEnabled", "contentMode",
                   "insetsLayoutMarginsFromSafeArea", "text", "textAlignment",
                   "lineBreakMode", "baselineAdjustment",
                   "adjustsFontForContentSizeCategory", "adjustsFontSizeToFit",
                   "id"},
}
ALLOWED_SUBS = {
    "view": {"frame", "autoresizingMask", "backgroundColor", "canvasLocation",
             "viewLayoutGuide"},
    "label": {"frame", "fontDescription", "highlightedColor", "textColor",
              "canvasLocation"},
    "imageView": {"frame", "constraints"},
    "placeholder": set(),
    "tableViewCell": {"frame", "autoresizingMask", "contentView", "connections",
                      "canvasLocation"},
    "tableViewCellContentView": {"frame", "autoresizingMask", "subviews",
                                 "constraints"},
    "cell-label": {"frame", "autoresizingMask", "fontDescription", "textColor",
                   "highlightedColor"},
}


def _check_shape(el, where, shape=None):
    allowed = ALLOWED_ATTRS.get(shape or el.tag)
    if allowed is None:
        raise XibError(f"unsupported element <{el.tag}> ({where})")
    unknown = set(el.attrib) - allowed
    if unknown:
        raise XibError(f"<{el.tag}> has unsupported attribute(s) {sorted(unknown)} ({where})")
    subs = {child.tag if child.tag == "viewLayoutGuide"
            else (child.get("key") or child.tag) for child in el}
    extra = subs - ALLOWED_SUBS[shape or el.tag]
    if extra:
        raise XibError(f"<{el.tag}> has unsupported subelement(s) {sorted(extra)} ({where})")


def build_view(b, el, where):
    _check_shape(el, where)
    mode = _attr(el, "contentMode", where)
    if mode != "scaleToFill":
        raise XibError(f"<view> contentMode={mode!r} not supported ({where})")
    (bx, by, bw, bh), (cx, cy) = _bounds_center(el)
    o = b.new("UIView")
    o.add("UIBounds", *b.geom(bx, by, bw, bh))
    o.add("UICenter", *b.geom(cx, cy))
    color = el.find("color[@key='backgroundColor']")
    if color is not None:
        sysname = color.get("systemColor")
        if sysname is None:
            raise XibError(f"<view> backgroundColor must use systemColor ({where})")
        o.add("UIBackgroundColor", *b.ref(build_color(b, sysname, where)))
    o.add("UIDeepDrawRect", *b.boolean(False))
    o.add("UIOpaque", *b.boolean(False))
    o.add("UIAutoresizeSubviews", *b.boolean(False))
    mask_el = el.find("autoresizingMask[@key='autoresizingMask']")
    mask = 0
    if mask_el is not None:
        if mask_el.get("widthSizable") == "YES":
            mask |= 2
        if mask_el.get("heightSizable") == "YES":
            mask |= 16
        unknown = set(mask_el.attrib) - {"key", "widthSizable", "heightSizable"}
        if unknown:
            raise XibError(f"<view> autoresizingMask has unsupported {sorted(unknown)} ({where})")
    o.add("UIAutoresizingMask", *b.int8(mask))
    o.add("UIViewSemanticContentAttribute", *b.int8(0))
    o.add("UIViewLargeContentStoredProperties", N.NIL, None)
    return o


def build_label(b, el, where):
    _check_shape(el, where)
    (bx, by, bw, bh), (cx, cy) = _bounds_center(el)
    o = b.new("UILabel")
    o.add("UIBounds", *b.geom(bx, by, bw, bh))
    o.add("UICenter", *b.geom(cx, cy))
    o.add("UIDeepDrawRect", *b.boolean(False))
    o.add("UIUserInteractionDisabled", *b.boolean(_attr(el, "userInteractionEnabled", where) != "NO"))
    o.add("UIAutoresizeSubviews", *b.boolean(False))
    o.add("UIAutoresizingMask", *b.int8(36))  # IB's default for translates=NO
    cm = _attr(el, "contentMode", where)
    if cm not in CONTENT_MODES:
        raise XibError(f"<label> contentMode={cm!r} not supported ({where})")
    o.add("UIContentMode", *b.int8(CONTENT_MODES[cm]))
    translates = el.get("translatesAutoresizingMaskIntoConstraints")
    if translates is None:
        raise XibError(f"<label> is missing translatesAutoresizingMaskIntoConstraints ({where})")
    o.add("UIViewDoesNotTranslateAutoresizingMaskIntoConstraints",
          *b.boolean(translates != "NO"))
    hug = f"{{{_attr(el, 'horizontalHuggingPriority', where)}, {_attr(el, 'verticalHuggingPriority', where)}}}"
    o.add("UIViewContentHuggingPriority", *b.ref(b.string(hug)))
    o.add("UIViewSemanticContentAttribute", *b.int8(0))
    o.add("UIViewLargeContentStoredProperties", N.NIL, None)
    o.add("UIText", *b.ref(b.string(_attr(el, "text", where))))
    adjusts = el.get("adjustsFontForContentSizeCategory")
    if adjusts is not None:
        o.add("UIAdjustsFontForContentSizeCategory", *b.boolean(False))
    o.add("UIFont", *b.ref(build_font(b, _sub(el, "fontDescription", where), where)))
    color_el = el.find("color[@key='textColor']")
    if color_el is None:
        o.add("UITextColor", *b.ref(build_color(b, "labelColor", where)))
    else:
        raise XibError(f"<label> explicit textColor not supported ({where})")
    o.add("UIShadowOffset", *b.geom(0.0, -1.0))
    ta = _attr(el, "textAlignment", where)
    if ta not in TEXT_ALIGNMENTS:
        raise XibError(f"<label> textAlignment={ta!r} not supported ({where})")
    o.add("UITextAlignment", *b.int8(TEXT_ALIGNMENTS[ta]))
    o.add("UIDisableUpdateTextColorOnTraitCollectionChange", *b.boolean(adjusts == "YES"))
    return o


def _cell_label(b, el, where, resources, role):
    """<label> inside a tableViewCellContentView -> UITableViewLabel."""
    _check_shape(el, where, shape="cell-label")
    (bx, by, bw, bh), (cx, cy) = _bounds_center(el)
    o = b.new("UITableViewLabel")
    o.add("UIBounds", *b.geom(bx, by, bw, bh))
    o.add("UICenter", *b.geom(cx, cy))
    o.add("UIDeepDrawRect", *b.boolean(False))
    if el.get("multipleTouchEnabled") is not None:
        o.add("UIMultipleTouchEnabled", *b.boolean(el.get("multipleTouchEnabled") != "YES"))
    o.add("UIAutoresizeSubviews", *b.boolean(False))
    cm = _attr(el, "contentMode", where)
    if cm not in CONTENT_MODES:
        raise XibError(f"<label> contentMode={cm!r} not supported ({where})")
    o.add("UIContentMode", *b.int8(CONTENT_MODES[cm]))
    if el.get("insetsLayoutMarginsFromSafeArea") is not None:
        o.add("UIViewInsetsLayoutMarginsFromSafeArea", *b.int8(0))
    o.add("UIViewSemanticContentAttribute", *b.int8(0))
    o.add("UIViewLargeContentStoredProperties", N.NIL, None)
    o.add("UIText", *b.ref(b.string(_attr(el, "text", where))))
    if el.get("adjustsFontForContentSizeCategory") is not None:
        o.add("UIAdjustsFontForContentSizeCategory", *b.boolean(False))
    o.add("UIFont", *b.ref(build_font(b, _sub(el, "fontDescription", where), where)))
    tc = el.find("color[@key='textColor']")
    if tc is not None and tc.get("systemColor") is not None:
        o.add("UITextColor", *b.ref(build_color(b, tc.get("systemColor"), where, resources)))
    else:
        o.add("UITextColor", *b.ref(build_color(b, "labelColor", where)))  # <nil/> or absent
    hc = el.find("color[@key='highlightedColor']")
    if hc is not None and hc.get("systemColor") is not None:
        o.add("UIHighlightedColor", *b.ref(build_color(b, hc.get("systemColor"), where, resources)))
    o.add("UIShadowOffset", *b.geom(0.0, -1.0))
    ta = _attr(el, "textAlignment", where)
    if ta not in TEXT_ALIGNMENTS:
        raise XibError(f"<label> textAlignment={ta!r} not supported ({where})")
    o.add("UITextAlignment", *b.int8(TEXT_ALIGNMENTS[ta]))
    # Golden: the cell's textLabel gets true, the detailTextLabel false.
    o.add("UIDisableUpdateTextColorOnTraitCollectionChange", *b.boolean(role == "text"))
    return o


def build_content_view(b, el, where, resources, roles, id_map):
    _check_shape(el, where)
    (bx, by, bw, bh), (cx, cy) = _bounds_center(el)
    o = b.new("UITableViewCellContentView")
    if el.get("id"):
        id_map[el.get("id")] = o
    o.add("UIBounds", *b.geom(bx, by, bw, bh))
    o.add("UICenter", *b.geom(cx, cy))
    subs = b.new("NSMutableArray")  # shell first, elements after (golden order)
    subs.add("NSInlinedValue", *b.boolean(False))
    o.add("UISubviews", *b.ref(subs))
    o.add("UIDeepDrawRect", *b.boolean(False))
    if el.get("multipleTouchEnabled") is not None:
        o.add("UIMultipleTouchEnabled", *b.boolean(el.get("multipleTouchEnabled") != "YES"))
    o.add("UIAutoresizeSubviews", *b.boolean(False))
    cm = _attr(el, "contentMode", where)
    if cm not in CONTENT_MODES:
        raise XibError(f"<tableViewCellContentView> contentMode={cm!r} not supported ({where})")
    o.add("UIContentMode", *b.int8(CONTENT_MODES[cm]))
    if el.get("clipsSubviews") is not None:
        o.add("UIClipsToBounds", *b.boolean(el.get("clipsSubviews") != "YES"))
    sv = el.find("subviews")
    if sv is None:
        raise XibError(f"<tableViewCellContentView> has no subviews ({where})")
    kids = []
    groups = []
    for child in sv:
        cid = child.get("id")
        if child.tag == "label":
            kids.append(_cell_label(b, child, where, resources, roles.get(cid, ""))
                        if cid in roles else build_label(b, child, where))
        elif child.tag == "imageView":
            kid, kgroup = build_image_view(b, child, where, id_map)
            kids.append(kid)
            groups.extend(kgroup)
        else:
            raise XibError(f"unsupported subview <{child.tag}> in contentView ({where})")
        if cid:
            id_map[cid] = kids[-1]
    for k in kids:
        subs.add("UINibEncoderEmptyKey", *b.ref(k))
    cons_el = el.find("constraints")
    if cons_el is not None:
        arr, cons = build_constraints_block(b, cons_el, o, id_map, where)
        o.add("UIViewAutolayoutConstraints", *b.ref(arr))
        groups.append(cons)
    if el.get("preservesSuperviewLayoutMargins") is not None:
        o.add("UIViewPreservesSuperviewMargins", *b.boolean(False))
        o.add("UIViewPreservesSpecificSuperviewMargins", *b.int8(15))
    if el.get("insetsLayoutMarginsFromSafeArea") is not None:
        o.add("UIViewInsetsLayoutMarginsFromSafeArea", *b.int8(0))
    o.add("UIViewSemanticContentAttribute", *b.int8(0))
    o.add("UIViewLargeContentStoredProperties", N.NIL, None)
    return o, kids, groups
def build_cell(b, el, where, resources):
    """<tableViewCell> -> UIClassSwapper (Apple wraps custom-class cells)."""
    _check_shape(el, where)
    id_map = {}
    x, y, w, h = _frame(el)
    (_, _, _, _), (cx, cy) = _bounds_center(el)
    o = b.new("UIClassSwapper")
    subs = b.new("NSMutableArray")  # shell; contentView + synthesized separator
    subs.add("NSInlinedValue", *b.boolean(False))
    o.add("UIBounds", *b.geom(0.0, 0.0, w, h))
    o.add("UICenter", *b.geom(cx, cy))
    o.add("UISubviews", *b.ref(subs))
    o.add("UIDeepDrawRect", *b.boolean(False))
    o.add("UIOpaque", *b.boolean(False))
    o.add("UIAutoresizeSubviews", *b.boolean(False))
    if el.get("clipsSubviews") is not None:
        o.add("UIClipsToBounds", *b.boolean(el.get("clipsSubviews") != "YES"))
    if el.get("preservesSuperviewLayoutMargins") is not None:
        o.add("UIViewPreservesSuperviewMargins", *b.boolean(False))
        o.add("UIViewPreservesSpecificSuperviewMargins", *b.int8(15))
    o.add("UIViewSemanticContentAttribute", *b.int8(0))
    o.add("UIViewLargeContentStoredProperties", N.NIL, None)

    cv_el = el.find("tableViewCellContentView[@key='contentView']")
    if cv_el is None:
        raise XibError(f"<tableViewCell> has no contentView ({where})")
    roles = {}
    if el.get("textLabel"):
        roles[el.get("textLabel")] = "text"
    if el.get("detailTextLabel"):
        roles[el.get("detailTextLabel")] = "detail"
    # Creation order = golden: contentView subtree, separator, then the
    # swapper's own strings (reuse identifier, class names).
    if el.get("id"):
        id_map[el.get("id")] = o
    cv, kids, groups = build_content_view(b, cv_el, where, resources, roles, id_map)
    # Apple synthesizes the separator: 1pt full-width view at the cell bottom.
    sep = b.new("_UITableViewCellSeparatorView")
    sep.add("UIBounds", *b.geom(0.0, 0.0, w - 8.0, 1.0))
    sep.add("UICenter", *b.geom(8.0 + (w - 8.0) / 2, h - 0.5))
    sep.add("UIDeepDrawRect", *b.boolean(False))
    sep.add("UIOpaque", *b.boolean(False))
    sep.add("UIAutoresizeSubviews", *b.boolean(False))
    sep.add("UIViewSemanticContentAttribute", *b.int8(0))
    sep.add("UIViewLargeContentStoredProperties", N.NIL, None)
    subs.add("UINibEncoderEmptyKey", *b.ref(cv))
    subs.add("UINibEncoderEmptyKey", *b.ref(sep))

    reuse = b.string(el.get("reuseIdentifier")) if el.get("reuseIdentifier") else None
    cls = el.get("customClass")
    module = el.get("customModule")
    if not cls:
        raise XibError(f"<tableViewCell> requires customClass in this subset ({where})")
    mangled = f"_TtC{len(module)}{module}{len(cls)}{cls}" if module else cls
    cls_str = b.string(mangled)
    orig_str = b.string("UITableViewCell")

    if reuse is not None:
        o.add("UIReuseIdentifier", *b.ref(reuse))
    style = el.get("style", "IBUITableViewCellStyleDefault")
    styles = {"IBUITableViewCellStyleDefault": 0, "IBUITableViewCellStyleValue1": 1,
              "IBUITableViewCellStyleSubtitle": 2, "IBUITableViewCellStyleValue2": 3}
    if style not in styles:
        raise XibError(f"<tableViewCell> style={style!r} not supported ({where})")
    if styles[style]:
        o.add("UITableViewCellStyle", *b.int8(styles[style]))
    acc = {"none": 0, "disclosureIndicator": 1, "detailDisclosureButton": 2,
           "checkmark": 3, "disclosureButton": 4}
    a = el.get("accessoryType", "none")
    if a not in acc:
        raise XibError(f"<tableViewCell> accessoryType={a!r} not supported ({where})")
    o.add("UIAccessoryType", *b.int8(acc[a]))
    o.add("UIIndentationWidth", *b.float32(float(el.get("indentationWidth", "10"))))
    o.add("UISystemBackgroundView", N.NIL, None)
    o.add("UIContentConfigurationView", N.NIL, None)
    o.add("UIContentView", *b.ref(cv))
    id_to_label = dict(zip([c.get("id") for c in cv_el.find("subviews").findall("label")],
                           kids))
    if el.get("textLabel"):
        o.add("UITextLabel", *b.ref(id_to_label[el.get("textLabel")]))
    else:
        o.add("UITextLabel", N.NIL, None)
    if el.get("detailTextLabel"):
        o.add("UIDetailTextLabel", *b.ref(id_to_label[el.get("detailTextLabel")]))
    else:
        o.add("UIDetailTextLabel", N.NIL, None)
    o.add("UIImageView", N.NIL, None)
    o.add("UIClassName", *b.ref(cls_str))
    o.add("UIOriginalClassName", *b.ref(orig_str))
    decode_order = [o, cv]
    if el.get("detailTextLabel"):
        decode_order.append(id_to_label[el.get("detailTextLabel")])
    if el.get("textLabel"):
        decode_order.append(id_to_label[el.get("textLabel")])
    decode_order += [k for k in kids if k not in decode_order]
    # constraints flattened in reverse group-creation order (golden-verified)
    for group in reversed(groups):
        decode_order += group
    outlets = []
    conns_el = el.find("connections")
    if conns_el is not None:
        for oc in conns_el.findall("outlet"):
            prop = oc.get("property")
            dst = id_map.get(oc.get("destination"))
            if not prop or dst is None:
                raise XibError(f"<tableViewCell> unparsable outlet {oc.attrib} ({where})")
            outlets.append((prop, dst))
    return o, decode_order, outlets


def compile_xib(path):
    """Compile one xib file to NIBArchive bytes. Raises XibError."""
    tree = ET.parse(path)
    doc = tree.getroot()
    if doc.get("targetRuntime") != "iOS.CocoaTouch":
        raise XibError(f"{path}: targetRuntime {doc.get('targetRuntime')!r} is not iOS.CocoaTouch")
    objects = doc.find("objects")
    if objects is None:
        raise XibError(f"{path}: no <objects> element")
    resources = {}
    res_el = doc.find("resources")
    if res_el is not None:
        for sc in res_el.findall("systemColor"):
            col = sc.find("color")
            try:
                resources[sc.get("name")] = (float(col.get("red")), float(col.get("green")),
                                             float(col.get("blue")), float(col.get("alpha")))
            except (TypeError, ValueError, AttributeError):
                raise XibError(f"{path}: unparsable systemColor resource {sc.get('name')!r}")

    where = os.path.basename(path)
    tops = []
    b = Builder()
    root = b.new("NSObject")
    top_array = b.new("NSArray")
    main_obj = decode_order = outlets = None
    for i, el in enumerate(objects):
        w = f"{where} object #{i}"
        if el.tag == "placeholder":
            _check_shape(el, w)
            ident = _attr(el, "placeholderIdentifier", w)
            if ident not in ("IBFilesOwner", "IBFirstResponder"):
                raise XibError(f"unsupported placeholder {ident!r} ({w})")
            p = b.new("UIProxyObject")
            p.add("UIProxiedObjectIdentifier", *b.ref(b.string(ident)))
            tops.append(p)
        elif main_obj is not None:
            raise XibError(f"{path}: multiple top-level objects are not supported")
        elif el.tag == "view":
            main_obj = build_view(b, el, w)
            decode_order = [main_obj]
        elif el.tag == "label":
            main_obj = build_label(b, el, w)
            decode_order = [main_obj]
        elif el.tag == "tableViewCell":
            main_obj, decode_order, outlets = build_cell(b, el, w, resources)
        else:
            raise XibError(f"unsupported element <{el.tag}> ({w})")
    if main_obj is None:
        raise XibError(f"{path}: no top-level object")
    objects_array = b.new("NSArray")
    outlet_array = None
    if outlets:
        outlet_array = b.new("NSArray")
        outlet_array.add("NSInlinedValue", *b.boolean(False))
        for prop, target in outlets:
            c = b.new("UIRuntimeOutletConnection")
            c.add("UILabel", *b.ref(b.string(prop)))
            c.add("UISource", *b.ref(main_obj))
            c.add("UIDestination", *b.ref(target))
            outlet_array.add("UINibEncoderEmptyKey", *b.ref(c))
    conn = b.new("NSArray")

    def fill_array(arr, items):
        arr.add("NSInlinedValue", *b.boolean(False))
        for item in items:
            arr.add("UINibEncoderEmptyKey", *b.ref(item))

    fill_array(top_array, tops + [main_obj])
    # UINibObjectsKey lists decode-order targets, not creation order (golden);
    # decode_order starts with the main object itself.
    fill_array(objects_array, tops + decode_order)
    conn.add("NSInlinedValue", *b.boolean(False))
    root.add("UINibTopLevelObjectsKey", *b.ref(top_array))
    root.add("UINibObjectsKey", *b.ref(objects_array))
    if outlet_array:
        empty_arr = b.new("NSArray")
        empty_arr.add("NSInlinedValue", *b.boolean(False))
    else:
        empty_arr = conn  # no outlets: all five root lists share one empty array
    root.add("UINibConnectionsKey", *b.ref(outlet_array if outlet_array else conn))
    for key in ("UINibVisibleWindowsKey", "UINibAccessibilityConfigurationsKey",
                "UINibTraitStorageListsKey", "UINibKeyValuePairsKey"):
        root.add(key, *b.ref(empty_arr))
    root.add("IBUINibLNEVersionKey", *b.int8(1))
    return finalize(b, root)


def finalize(b, root):
    """Serialize a built object graph: key table (__NSSetM simulation over the
    first-intern order, KEY_LAYOUTS as fallback), class table, encode."""
    # Flatten values in object order; classes in first-use order.
    values = []
    classes = []
    class_idx = {}
    creation_keys = []
    creation_idx = {}
    SUPERCLASS = {"UIColor": "NSColor", "UIFont": "NSFont",
                  "UITableViewCellContentView": "UIView"}
    for o in b.objects:
        o.value_start = len(values)
        for key, v in o.values:
            if key not in creation_idx:
                creation_idx[key] = len(creation_keys)
                creation_keys.append(key)
            v.key_idx = creation_idx[key]
            values.append(v)
        o.value_count = len(values) - o.value_start
        if o.cls not in class_idx:
            class_idx[o.cls] = len(classes)
            classes.append([o.cls, ()])
    for s in sorted({SUPERCLASS[c] for c in class_idx if c in SUPERCLASS}):
        class_idx[s] = len(classes)
        classes.append([s, ()])
    for c in classes:
        if c[0] in SUPERCLASS:
            c[1] = (class_idx[SUPERCLASS[c[0]]],)

    # Key table: run the __NSSetM simulation over the first-intern order
    # (inline DFS), derived from a probe archive of this exact graph.
    creation_keys = []
    seen = set()
    for o in b.objects:
        for key, _ in o.values:
            if key not in seen:
                seen.add(key)
                creation_keys.append(key)
    arch = N.Archive()
    arch.version = 1
    arch.minor = 10
    arch.keys = [k.encode("ascii") for k in creation_keys]
    arch.classes = [(name.encode("ascii") + b"\x00", extras) for name, extras in classes]
    arch.objects = [N.Object(class_idx[o.cls], o.value_start, o.value_count)
                    for o in b.objects]
    arch.values = values
    key_idx = {k: i for i, k in enumerate(creation_keys)}
    for o in b.objects:
        for key, v in o.values:
            v.key_idx = key_idx[key]

    key_bytes = None
    try:
        import keyorder
        arch_keys = keyorder.key_order(keyorder.first_use_order(arch))
        if sorted(arch_keys) == sorted(creation_keys):
            key_bytes = list(arch_keys)
    except ImportError:
        pass
    if key_bytes is None:
        layout = KEY_LAYOUTS.get(frozenset(seen))
        if layout is None:
            raise XibError(f"no known key-table layout for key set "
                           f"{sorted(seen)} (add it to KEY_LAYOUTS from golden bytes)")
        key_bytes = [k.encode("ascii") for k in layout]
    remap = {k: i for i, k in enumerate(key_bytes)}
    assert len(remap) == len(creation_keys) and all(k in remap for k in creation_keys)
    for v in values:
        v.key_idx = remap[creation_keys[v.key_idx]]
    arch.keys = [k.encode("ascii") for k in key_bytes]
    return N.encode(arch)


SELF_TEST_NIBS = ("TinyView", "TinyLabel", "SettingsTableViewCell")

# (label, src rel under SRC, golden rel under GOLDEN)
SB_SELF_TEST = (
    ("LaunchScreenPhone.storyboardc",
     "NetNewsWire/Base.lproj/LaunchScreenPhone.storyboard",
     "Base.lproj/LaunchScreenPhone.storyboardc"),
    ("LaunchScreenPad.storyboardc",
