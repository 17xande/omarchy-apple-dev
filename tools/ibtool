def _bplist_bytes(plist):
    """Serialize {str: dict|str|int} exactly like Apple's storyboardc
    Info.plist: bplist00, pre-order object assignment (dict keys before
    values, containers expanded immediately), no string uniquing,
    1-byte refs, offsets sized to fit."""
    import collections
    objects = []  # encoded bytes, index == object number

    def assign(v):
        i = len(objects)
        objects.append(None)
        if isinstance(v, dict):
            krefs = [assign(k) for k in v]
            vrefs = [assign(v[k]) for k in v]
            if len(v) > 15:
                raise XibError(f"Info.plist dict too large: {len(v)}")
            objects[i] = bytes([0xD0 | len(v)] + krefs + vrefs)
        elif isinstance(v, str):
            data = v.encode("ascii")
            if len(data) <= 14:
                objects[i] = bytes([0x50 | len(data)]) + data
            elif len(data) < 256:
                objects[i] = bytes([0x5F, 0x10, len(data)]) + data
            else:
                raise XibError("Info.plist string too long")
        elif isinstance(v, int) and 0 <= v < 256:
            objects[i] = bytes([0x10, v])
        else:
            raise XibError(f"unsupported Info.plist value {v!r}")
        return i

    assign(plist)
    body = b"".join(objects)
    off_sz = 1 if 8 + len(body) + len(objects) <= 255 else 2
    pos = 8  # offsets are absolute file positions (magic included)
    table = b""
    for x in objects:
        table += pos.to_bytes(off_sz, "big")
        pos += len(x)
    out = b"bplist00" + body + table
    out += b"\x00" * 5 + b"\x00" + bytes([off_sz, 1])
    out += len(objects).to_bytes(8, "big") + (0).to_bytes(8, "big")
    out += (8 + len(body)).to_bytes(8, "big")
    return out


def _layout_guide(b, el, where):
    g = b.new("UILayoutGuide")
    g.add("UILayoutGuideOwningView", N.NIL, None)
    g.add("UILayoutGuideIdentifier", *b.ref(b.string(el.get("identifier", ""))))
    g.add("UILayoutGuideOwningViewIsLocked", N.TRUE, None)
    g.add("UILayoutGuideShouldBeArchived", N.TRUE, None)
    g.add("UILayoutGuideAllowsNegativeDimensions", N.TRUE, None)
    return g


def build_constraint(b, el, owner, id_map, where):
    o = b.new("NSLayoutConstraint")
    first = el.get("firstItem")
    o.add("NSFirstItem", *b.ref(id_map[first] if first else owner))
    fa = el.get("firstAttribute")
    if fa is None:
        raise XibError(f"<constraint> missing firstAttribute ({where})")
    o.add("NSFirstAttributeV2", *b.int8(ATTRIBUTES.get(fa, MARGIN_V2.get(fa, 0))))
    o.add("NSFirstAttribute", *b.int8(ATTRIBUTES.get(MARGIN_BASE.get(fa, fa), 0)))
    second = el.get("secondItem")
    if second is not None:
        o.add("NSSecondItem", *b.ref(id_map[second]))
        sa = el.get("secondAttribute")
        if sa is None:
            raise XibError(f"<constraint> secondItem without secondAttribute ({where})")
        o.add("NSSecondAttributeV2", *b.int8(ATTRIBUTES.get(sa, MARGIN_V2.get(sa, 0))))
        o.add("NSSecondAttribute", *b.int8(ATTRIBUTES.get(MARGIN_BASE.get(sa, sa), 0)))
    rel = RELATIONS.get(el.get("relation", "equal"))
    if rel is not None:
        o.add("NSRelation", *b.int8(rel))
    if el.get("symbolic") == "YES":
        o.add("NSSymbolicConstant", *b.ref(b.string("NSSpace")))
        o.add("NSShouldBeArchived", *b.boolean(False))
    elif el.get("constant") is not None:
        c = float(el.get("constant"))
        o.add("NSConstantV2", *b.float64(c))
        o.add("NSShouldBeArchived", *b.boolean(False))
        o.add("NSConstant", *b.float64(c))
    else:
        o.add("NSShouldBeArchived", *b.boolean(False))
    return o


def build_constraints_block(b, el, owner, id_map, where):
    """<constraints> of a view -> (NSMutableArray shell, constraint objects)."""
    arr = b.new("NSMutableArray")
    arr.add("NSInlinedValue", *b.boolean(False))
    cons = [build_constraint(b, c, owner, id_map, where) for c in el.findall("constraint")]
    for c in cons:
        arr.add("UINibEncoderEmptyKey", *b.ref(c))
    return arr, cons


def build_image_view(b, el, where, id_map):
    _check_shape(el, where, shape="imageView")
    (bx, by, bw, bh), (cx, cy) = _bounds_center(el)
    o = b.new("UIImageView")
    if el.get("id"):
        id_map[el.get("id")] = o
    o.add("UIBounds", *b.geom(bx, by, bw, bh))
    o.add("UICenter", *b.geom(cx, cy))
    o.add("UIDeepDrawRect", *b.boolean(False))
    o.add("UIOpaque", *b.boolean(False))
    if el.get("userInteractionEnabled") is not None:
        o.add("UIUserInteractionDisabled", *b.boolean(el.get("userInteractionEnabled") != "NO"))
    o.add("UIAutoresizeSubviews", *b.boolean(False))
    o.add("UIAutoresizingMask", *b.int8(36))
    cm = _attr(el, "contentMode", where)
    if cm not in CONTENT_MODES:
        raise XibError(f"<imageView> contentMode={cm!r} not supported ({where})")
    o.add("UIContentMode", *b.int8(CONTENT_MODES[cm]))
    if el.get("clipsSubviews") is not None:
        o.add("UIClipsToBounds", *b.boolean(el.get("clipsSubviews") != "YES"))
    tr = el.get("translatesAutoresizingMaskIntoConstraints")
    if tr is not None:
        o.add("UIViewDoesNotTranslateAutoresizingMaskIntoConstraints",
              *b.boolean(tr != "NO"))
    group = []
    cons_el = el.find("constraints")
    if cons_el is not None:
        arr, cons = build_constraints_block(b, cons_el, o, id_map, where)
        o.add("UIViewAutolayoutConstraints", *b.ref(arr))
        group.append(cons)
    if el.get("horizontalHuggingPriority") is not None:
        hug = f"{{{_attr(el, 'horizontalHuggingPriority', where)}, {_attr(el, 'verticalHuggingPriority', where)}}}"
        o.add("UIViewContentHuggingPriority", *b.ref(b.string(hug)))
    o.add("UIViewSemanticContentAttribute", *b.int8(0))
    o.add("UIViewLargeContentStoredProperties", N.NIL, None)
    return o, group


def _scene_view_nib(vc_el, view_el, view_nib_name, where, resources):
    """The VC's view compiles into its own nib: <vcId>-view-<viewId>.nib."""
    b = Builder()
    root = b.new("NSObject")
    top_array = b.new("NSArray")
    fo = _proxy(b, "IBFilesOwner")
    fr = _proxy(b, "IBFirstResponder")
    view = build_view(b, view_el, where)
    objarr = b.new("NSArray")  # shell before the guides (golden order)
    guides = [_layout_guide(b, g, where)
              for g in view_el.findall("viewLayoutGuide")]
    conn_arr = b.new("NSArray")
    conn = b.new("UIRuntimeOutletConnection")
    conn.add("UILabel", *b.ref(b.string("view")))
    conn.add("UISource", *b.ref(fo))
    conn.add("UIDestination", *b.ref(view))

    def fill(arr, items, inline=False):
        arr.add("NSInlinedValue", *b.boolean(False))
        for item in items:
            arr.add("UINibEncoderEmptyKey", *b.ref(item))

    fill(top_array, [fo, fr, view])
    fill(objarr, [fo, fr, view] + guides)
    fill(conn_arr, [conn])
    empty = b.new("NSArray")
    fill(empty, [])
    root.add("UINibTopLevelObjectsKey", *b.ref(top_array))
    root.add("UINibObjectsKey", *b.ref(objarr))
    root.add("UINibConnectionsKey", *b.ref(conn_arr))
    for key in ("UINibVisibleWindowsKey", "UINibAccessibilityConfigurationsKey",
                "UINibTraitStorageListsKey", "UINibKeyValuePairsKey"):
        root.add(key, *b.ref(empty))
    root.add("IBUINibLNEVersionKey", *b.int8(1))
    return finalize(b, root), guides


def _proxy(b, ident):
    p = b.new("UIProxyObject")
    p.add("UIProxiedObjectIdentifier", *b.ref(b.string(ident)))
    return p


def _scene_vc_nib(vc_el, view_nib_name, where):
    """The VC scene nib: proxies + the class swapper pointing at the view nib."""
    vc_id = vc_el.get("id")
    ident = vc_el.get("storyboardIdentifier")
    vc_name = ident or f"UIViewController-{vc_id}"
    cls = vc_el.get("customClass") or "UIViewController"
    b = Builder()
    root = b.new("NSObject")
    top_array = b.new("NSArray")
    fo = _proxy(b, "IBFilesOwner")
    fr = _proxy(b, "IBFirstResponder")
    sb = _proxy(b, "UIStoryboardPlaceholder")
    sw = b.new("UIClassSwapper")
    ext = b.new("NSDictionary")
    ext.add("NSInlinedValue", *b.boolean(False))
    sw.add("UIExternalObjectsTableForViewLoading", *b.ref(ext))
    if ident:
        sw.add("UIStoryboardIdentifier", *b.ref(b.string(ident)))
    sw.add("UINibName", *b.ref(b.string(view_nib_name)))
    sw.add("UIClassName", *b.ref(b.string(cls)))
    sw.add("UIOriginalClassName", *b.ref(b.string(vc_el.get("customClass") or "UIViewController")))
    objarr = b.new("NSArray")
    conn_arr = b.new("NSArray")
    c1 = b.new("UIRuntimeOutletConnection")
    c1.add("UILabel", *b.ref(b.string("storyboard")))
    c1.add("UISource", *b.ref(sw))
    c1.add("UIDestination", *b.ref(sb))
    c2 = b.new("UIRuntimeOutletConnection")
    c2.add("UILabel", *b.ref(b.string("sceneViewController")))
    c2.add("UISource", *b.ref(fo))
    c2.add("UIDestination", *b.ref(sw))

    def fill(arr, items):
        arr.add("NSInlinedValue", *b.boolean(False))
        for item in items:
            arr.add("UINibEncoderEmptyKey", *b.ref(item))

    fill(top_array, [fo, fr, sb, sw])
    fill(objarr, [fo, fr, sb, sw])
    fill(conn_arr, [c1, c2])
    empty = b.new("NSArray")
    fill(empty, [])
    root.add("UINibTopLevelObjectsKey", *b.ref(top_array))
    root.add("UINibObjectsKey", *b.ref(objarr))
    root.add("UINibConnectionsKey", *b.ref(conn_arr))
    for key in ("UINibVisibleWindowsKey", "UINibAccessibilityConfigurationsKey",
                "UINibTraitStorageListsKey", "UINibKeyValuePairsKey"):
        root.add(key, *b.ref(empty))
    root.add("IBUINibLNEVersionKey", *b.int8(1))
    return finalize(b, root), vc_name


def compile_storyboard(path, compilation_dir):
    """Xcode's CompileStoryboard: write <dir>/<name>.storyboardc/."""
    tree = ET.parse(path)
    doc = tree.getroot()
    if doc.get("targetRuntime") != "iOS.CocoaTouch":
        raise XibError(f"{path}: targetRuntime {doc.get('targetRuntime')!r} is not iOS.CocoaTouch")
    name = os.path.splitext(os.path.basename(path))[0]
    resources = {}
    res_el = doc.find("resources")
    if res_el is not None:
        for sc in res_el.findall("systemColor"):
            col = sc.find("color")
            try:
                resources[sc.get("name")] = (float(col.get("red")), float(col.get("green")),
                                             float(col.get("blue")), float(col.get("alpha")))
            except (TypeError, ValueError, AttributeError):
                continue  # non-RGBA specs (white/gray); the named table or a
                # later clear error handles them
    scenes = doc.findall("scenes/scene")
    if not scenes:
        raise XibError(f"{path}: no scenes")
    identifiers = {}
    id_to_name = {}
    entry_id = doc.get("initialViewController")
    sbc = os.path.join(compilation_dir, f"{name}.storyboardc")
    os.makedirs(sbc, exist_ok=True)
    where = os.path.basename(path)
    for si, scene in enumerate(scenes):
        objs = scene.find("objects")
        vc_el = objs.find("viewController") if objs is not None else None
        if vc_el is None:
            raise XibError(f"{where}: scene #{si} has no viewController (unsupported scene kind)")
        view_el = vc_el.find("view[@key='view']")
        if view_el is None or not view_el.get("id"):
            raise XibError(f"{where}: scene #{si} viewController has no view")
        vc_id = vc_el.get("id")
        if not vc_id:
            raise XibError(f"{where}: scene #{si} viewController has no id")
        view_nib = f"{vc_id}-view-{view_el.get('id')}"
        arch, vc_name = _scene_vc_nib(vc_el, view_nib, where)
        with open(os.path.join(sbc, vc_name + ".nib"), "wb") as f:
            f.write(arch)
        varch, _ = _scene_view_nib(vc_el, view_el, view_nib, where, resources)
        with open(os.path.join(sbc, view_nib + ".nib"), "wb") as f:
            f.write(varch)
        identifiers[vc_name] = vc_name
        id_to_name[vc_id] = vc_name
    entry = (id_to_name.get(entry_id) if entry_id else None) or next(iter(identifiers))
    plist = {
        "UIViewControllerIdentifiersToNibNames": dict(identifiers),
        "UIStoryboardDesignatedEntryPointIdentifier": entry,
        "UIStoryboardVersion": 1,
    }
    with open(os.path.join(sbc, "Info.plist"), "wb") as f:
        f.write(_bplist_bytes(plist))
    return sbc


def link_storyboards(out_dir, sources):
    """Xcode's LinkStoryboards: copy each .storyboardc into out_dir keeping
    its .lproj parent (verified: the golden trees carry nothing else)."""
    import shutil
    made = []
    for src in sources:
        parent = os.path.basename(os.path.dirname(os.path.abspath(src)))
        lproj = parent if parent.endswith(".lproj") else ""
        dest_dir = os.path.join(out_dir, lproj) if lproj else out_dir
        dest = os.path.join(dest_dir, os.path.basename(src))
        os.makedirs(dest_dir, exist_ok=True)
        shutil.copytree(src, dest, dirs_exist_ok=True)
        made.append(dest)
    return made


def _tree_bytes(root):
    out = {}
    for dirpath, _, files in os.walk(root):
        for f in files:
            p = os.path.join(dirpath, f)
            out[os.path.relpath(p, root)] = open(p, "rb").read()
    return out


# (label, src rel under SRC, golden rel under GOLDEN)
SB_SELF_TEST = (
    ("LaunchScreenPhone.storyboardc",
     "NetNewsWire/Base.lproj/LaunchScreenPhone.storyboard",
     "Base.lproj/LaunchScreenPhone.storyboardc"),
    ("LaunchScreenPad.storyboardc",
     "NetNewsWire/Base.lproj/LaunchScreenPad.storyboard",
     "Base.lproj/LaunchScreenPad.storyboardc"),
    ("Mastodon Main.storyboardc",
     "Mastodon/Base.lproj/Main.storyboard",
     "Mastodon/Base.lproj/Main.storyboardc"),
)


def self_test():
    import glob
    import tempfile
    failed = []
    nibs = sorted(p for p in glob.glob(os.path.join(GOLDEN, "**", "*.nib"), recursive=True)
                  if os.path.isfile(p))
    for p in nibs:
        raw = open(p, "rb").read()
        if N.encode(N.parse(raw)) != raw:
            failed.append(f"round-trip {os.path.basename(p)}")
    compiled = []
    for name in SELF_TEST_NIBS:
        src = os.path.join(SRC, f"{name}.xib")
        if not os.path.isfile(src):
            src = os.path.join(SRC, "NetNewsWire", f"{name}.xib")
        out = compile_xib(src)
        want = open(os.path.join(GOLDEN, f"{name}.nib"), "rb").read()
        if out != want:
            diff = next((i for i, (x, y) in enumerate(zip(out, want)) if x != y),
                        min(len(out), len(want)))
            failed.append(f"{name}.nib: {len(out)} vs {len(want)} bytes, first diff at {diff}")
        compiled.append(name)
    for label, src_rel, golden_rel in SB_SELF_TEST:
        tmp = tempfile.mkdtemp(prefix="/tmp/ibtool-sbtest-")
        dirpart = os.path.dirname(golden_rel)
        module = dirpart.split("/")[0] if "/" in dirpart else ""
        sbc = compile_storyboard(os.path.join(SRC, src_rel),
                                 os.path.join(tmp, "stage", dirpart))
        # Apple's --link nests only the .lproj parent under OUT; the module
        # segment comes from OUT itself (as compile-golden.sh does).
        out_root = os.path.join(tmp, "out", module)
        link_storyboards(out_root, [sbc])
        mine = _tree_bytes(out_root)
        cut = len(module) + 1 if module else 0
        stripped = golden_rel[cut:]
        prefix = stripped + "/"
        want = {k[cut:]: v for k, v in _tree_bytes(GOLDEN).items()
                if k.startswith((module + "/" if module else "") + prefix)}
        if mine == want:
            compiled.append(label)
        else:
            detail = [f"{k}: {'missing' if k not in mine else 'differs' if k in want else 'extra'}"
                      for k in sorted(set(mine) | set(want))
                      if mine.get(k) != want.get(k)]
            failed.append(f"{label}: {detail}")
    if failed:
        raise SystemExit("self-test FAILED: " + "; ".join(failed))
    print(f"self-test passed (round-trip {len(nibs)} golden nibs; "
          f"{' and '.join(compiled)} byte-identical to golden)")


def main(argv):
    if "--version" in argv:
        sys.stdout.write(VERSION_XML)
        return 0
    if "--self-test" in argv:
        self_test()
        return 0
    flags_with_value = {"--module", "--output-partial-info-plist",
                        "--minimum-deployment-target", "--output-format",
                        "--compilation-directory", "--target-device"}
    known_flags = flags_with_value | {"--errors", "--warnings",
                                      "--notices", "--auto-activate-custom-fonts",
                                      "--compile", "--link"}
    action = None
    action_args = []
    positional = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--compile" or a == "--link":
            action = a
            action_args = argv[i + 1:]
            break
        if a in flags_with_value:
            i += 2
            continue
        if a in known_flags:
            i += 1
            continue
        if a.endswith(".storyboard"):
            positional.append(a)
            i += 1
            continue
        print(f"error: ibtool: unknown argument {a!r}", file=sys.stderr)
        return 2

    def partial_plist():
        for j, a in enumerate(argv):
            if a == "--output-partial-info-plist":
                p = argv[j + 1]
                os.makedirs(os.path.dirname(os.path.abspath(p)), exist_ok=True)
                with open(p, "wb") as f:
                    plistlib.dump({}, f)

    def comp_dir():
        for j, a in enumerate(argv):
            if a == "--compilation-directory":
                return argv[j + 1]
        return None

    if positional and not action:
        # CompileStoryboard: ibtool [flags] IN.storyboard --compilation-directory DIR
        if len(positional) != 1 or not comp_dir():
            print("error: ibtool: storyboard compile needs one .storyboard and "
                  "--compilation-directory", file=sys.stderr)
            return 2
        try:
            sbc = compile_storyboard(positional[0], comp_dir())
        except (XibError, ET.ParseError) as e:
            print(f"error: ibtool: {e}", file=sys.stderr)
            return 1
        partial_plist()
        print(f"/* {sbc} */", file=sys.stderr)
        return 0
    if action == "--compile":
        if len(action_args) != 2:
            print("error: ibtool: --compile needs OUT.nib and IN.xib", file=sys.stderr)
            return 2
        out, xib = action_args
        try:
            data = compile_xib(xib)
        except (XibError, ET.ParseError) as e:
            print(f"error: ibtool: {e}", file=sys.stderr)
            return 1
        partial_plist()
        tmp = out + ".tmp-nibarchive"
        with open(tmp, "wb") as f:
            f.write(data)
        os.replace(tmp, out)  # no partial output on failure
        return 0
    if action == "--link":
        # LinkStoryboards: ibtool [flags] --link OUT SRC.storyboardc...
        if len(action_args) < 2:
            print("error: ibtool: --link needs OUT and at least one .storyboardc",
                  file=sys.stderr)
            return 2
        out, sources = action_args[0], action_args[1:]
        try:
            link_storyboards(out, sources)
        except OSError as e:
            print(f"error: ibtool: {e}", file=sys.stderr)
            return 1
        return 0
    print("error: ibtool: no action given (expected --compile, --link, a "
          ".storyboard input, or --version)",
          file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
