    UINibObjectsKey UINibConnectionsKey IBUINibLNEVersionKey
    UISystemColorName UINibTraitStorageListsKey""".split(),
    # TinyLabel.nib
    """UINibVisibleWindowsKey UINibAccessibilityConfigurationsKey UIBounds
    NS.bytes UINibEncoderEmptyKey UIUserInteractionDisabled NSSize UIFontName
    UIFontDescriptor UIFontPointSizeForScaling NSInlinedValue UIFont
    UIContentMode NSWhite UIDisableUpdateTextColorOnTraitCollectionChange
    UIFontDescriptorOptions UIViewLargeContentStoredProperties UISystemFont
